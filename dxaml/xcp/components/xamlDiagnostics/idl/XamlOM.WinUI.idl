cpp_quote("#pragma region Application Family")
cpp_quote("#if WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)")

#include <sdkddkver.h>

// Include the existing Windows.UI.Xaml version of XamlOM.idl, which defines
// most of the interfaces the WinUI XamlDiagnostics implements.
// The interfaces defined in this XamlOM.WinUI.idl file are for new functionality
// exclusive to WinUI 3.
import "XamlOM.idl";

cpp_quote("// Win32 API definitions")
cpp_quote("#define E_NOTFOUND HRESULT_FROM_WIN32(ERROR_NOT_FOUND)")
cpp_quote("#define E_UNKNOWNTYPE MAKE_HRESULT(SEVERITY_ERROR, FACILITY_XAML, 40L)")


// Interfaces.

// IVisualTreeServiceCallback3: implemented by the tap dll
// to receive change notifications about XamlRoots being added/removed.
// Used to support multi-window and multi-island scenarios.
[
    object,
    uuid(765DF10A-08C8-46B0-82C9-297CFC4CEAD7),
    pointer_default(unique)
]
interface IVisualTreeServiceCallback3 : IUnknown
{
    HRESULT OnXamlRootChange(
        [in] InstanceHandle root,
        [in] VisualMutationType mutationType);
};

// IXamlDiagnostics2: implemented by WinUI 3's XamlDiagnostics instance
// to provide multi-window/multi-island specific functionality.
// GetUiLayerForXamlRoot returns the UI layer used to host the in-app toolbar
// for the XamlRoot instanceHandle passed in.
// HitTestForXamlRoot hit tests for the XamlRoot instanceHandle passed in
// within the given bounds rect.
[
    object,
    uuid(523A35EE-EB38-4AE6-A3E1-5B7D0D547BD0),
    pointer_default(unique)
]
interface IXamlDiagnostics2 : IUnknown
{
    HRESULT GetUiLayerForXamlRoot(
        [in] InstanceHandle instanceHandle,
        [out, retval] IInspectable** ppLayer);
    HRESULT HitTestForXamlRoot(
        [in] InstanceHandle instanceHandle,
        [in] RECT rect,
        [out] unsigned int* pCount,
        [out, size_is(, *pCount)] InstanceHandle** ppInstanceHandles);
};

// XAML hot reload.
//
// A diagnostics tool (the tap dll this XamlDiagnostics instance was sited on) can give the app new compiled markup
// for its own components while it runs, hear when components load, and tell the runtime that types changed. The
// tool then re-creates what it changed (for example, it navigates a Frame to the page again).
//
// Only apps built with the hot reload stamp allow it: the XAML build writes Microsoft.UI.Xaml.HotReload.enabled to
// the app's output folder (and so its package root) for debug builds, or when the project sets
// EnableXamlHotReload=true. Without the stamp, every method returns E_XAMLHOTRELOAD_NOTENABLED and nothing changes.

cpp_quote("#define E_XAMLHOTRELOAD_NOTENABLED MAKE_HRESULT(SEVERITY_ERROR, FACILITY_XAML, 41L)")

// IXamlComponentLoadedCallback: implemented by the tool. Called on the loading thread after every successful
// Application.LoadComponent (which InitializeComponent calls). A failure it returns is ignored.
[
    object,
    uuid(7AF94B54-7C75-42C3-B717-44F25C491A27),
    pointer_default(unique)
]
interface IXamlComponentLoadedCallback : IUnknown
{
    HRESULT OnComponentLoaded(
        [in] IInspectable* component,
        [in, string] LPCWSTR uri);
};

// IXamlHotReloadService: implemented by WinUI 3's XamlDiagnostics instance; a tool gets it with QueryInterface.
// Callable from any thread. Each UI thread picks up changes on its next load.
[
    object,
    uuid(1DB88325-CDAB-4BB7-8964-38D9D29F80DB),
    pointer_default(unique)
]
interface IXamlHotReloadService : IUnknown
{
    // Later loads of the component at uri read xbf instead of its built .xbf. uri is the component's markup URI as
    // InitializeComponent passes it (ms-appx:///Views/MainPage.xaml) or its .xbf form; ms-resource:///Files/<path>
    // is the same as ms-appx:///<path>. xbf is what the XAML compiler produces for the edited file, and is copied.
    // WinUI's own markup is refused with E_INVALIDARG. Instances already loaded keep their content.
    HRESULT SetComponentXbf(
        [in, string] LPCWSTR uri,
        [in] UINT32 size,
        [in, size_is(size)] const BYTE* xbf);

    HRESULT AdviseComponentLoaded(
        [in] IXamlComponentLoadedCallback* callback,
        [out] DWORD* cookie);

    HRESULT UnadviseComponentLoaded(
        [in] DWORD cookie);

    // The app's types changed while it runs (for example, through .NET hot reload): new types may exist, and types
    // already used may have new members. Earlier "not found" answers are forgotten, and each custom type is asked
    // for again from its metadata provider the next time a member lookup on it finds nothing. Types keep their
    // identity, so live objects, styles and bindings that use them keep working.
    HRESULT InvalidateTypeCaches();
};

cpp_quote("#endif /* WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP) */ ")
cpp_quote("#pragma endregion")
