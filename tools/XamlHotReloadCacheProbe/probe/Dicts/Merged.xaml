<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CacheProbe">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <x:String x:Key="ThemedText">light-v1</x:String>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <x:String x:Key="ThemedText">dark-v1</x:String>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <x:String x:Key="MergedText">merged-v1</x:String>
    <Style TargetType="local:ImplicitProbe">
        <Setter Property="Tag" Value="implicit-v1" />
    </Style>
    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="based-v1" />
    </Style>
    <DataTemplate x:Key="MergedTemplate">
        <TextBlock AutomationProperties.AutomationId="MergedTemplateText" Text="mtmpl-v1" />
    </DataTemplate>
</ResourceDictionary>
