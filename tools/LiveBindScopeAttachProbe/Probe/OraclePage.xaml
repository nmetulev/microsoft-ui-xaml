<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-built oracle. Its {x:Bind} scope is produced by the stock XAML compiler at build time and
     wired by the stock parser path, so it is the reference behaviour every live-attach assertion is
     compared against. -->
<Page
    x:Class="LiveBindScopeProbe.OraclePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiveBindScopeProbe"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <StackPanel>
        <TextBlock x:Name="TitleText" x:FieldModifier="public" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
        <TextBlock x:Name="AltText" x:FieldModifier="public" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
        <ListView x:Name="TodoList" x:FieldModifier="public" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" />
    </StackPanel>
</Page>
