<!--
  Developer tool for the XAML compiler service: prepares baseline inputs, benchmarks warm
  per-page compiles, and measures feeding the compiler an in-memory Roslyn emit.
  Not part of the product build.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <SignAssembly>false</SignAssembly>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Microsoft.UI.Xaml.Markup.Compiler.csproj" SetTargetFramework="TargetFramework=net8.0" />
    <ProjectReference Include="..\..\Exe\Microsoft.UI.Xaml.Markup.Compiler.MSBuildInterop\Microsoft.UI.Xaml.Markup.Compiler.MSBuildInterop.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>
</Project>
